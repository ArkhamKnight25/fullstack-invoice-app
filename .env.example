# Root .env — consumed by both backend (directly) and referenced for frontend setup

# MongoDB connection string
# Local:  mongodb://localhost:27017/invoice_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/invoice_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/invoice_db

# Express port
PORT=5000

# Comma-separated allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# --- frontend/.env ---
# VITE_API_URL=http://localhost:5000/api
# For production: VITE_API_URL=https://your-backend.onrender.com/api
